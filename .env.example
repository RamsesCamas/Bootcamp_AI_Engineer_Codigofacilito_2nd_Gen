# Copia este archivo a .env y llena tus llaves. Nunca subas .env al repositorio.

# --- Llaves de API ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# --- Modelos ---
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=llama3.2
# Ollama corre local; no necesita llave.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Cadena de proveedores ---
# Proveedor principal y lista de respaldos en orden (formato JSON).
PRIMARY=gemini
FALLBACKS=["groq"]

# --- Robustez ---
# Segundos máximos de espera por request.
TIMEOUT_S=30
# Reintentos por proveedor ante errores transitorios (429, 5xx, timeouts).
MAX_RETRIES=3

# --- Observabilidad ---
# Archivo JSONL donde se registra cada llamada.
LOG_PATH=logs/llm_calls.jsonl
